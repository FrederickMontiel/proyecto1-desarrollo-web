# ---------------------------------------------------------------------------
# Configuración de despliegue. Copiar a .env y sustituir los valores.
#   cp .env.example .env
# El archivo .env no se versiona: contiene credenciales.
#
# Cada microservicio tiene su propio usuario de base de datos: ninguno conoce
# la contraseña de la base de otro. Generar contraseñas con:
#   openssl rand -base64 24
# ---------------------------------------------------------------------------

# --- PostgreSQL 18 (Auth, Community, Alert) ---
POSTGRES_PASSWORD=cambie-esta-clave-postgres
AUTH_DB_PASSWORD=cambie-esta-clave-auth
COMMUNITY_DB_PASSWORD=cambie-esta-clave-community
ALERT_DB_PASSWORD=cambie-esta-clave-alert

# --- SQL Server 2022 (Sensor) ---
# Requisitos del motor: mínimo 8 caracteres, con mayúsculas, minúsculas y dígitos o símbolos.
MSSQL_SA_PASSWORD=Swmatrc.Local.2026
SENSOR_DB_PASSWORD=Sensor.Local.2026
# Base del sistema de la Fase 2. Solo la lee la herramienta de migración.
MSSQL_DATABASE_LEGADO=SwmatrcDb

# --- MongoDB 8 (Report, Audit) ---
MONGO_ROOT_PASSWORD=cambie-esta-clave-mongo
REPORT_DB_PASSWORD=cambie-esta-clave-report
AUDIT_DB_PASSWORD=cambie-esta-clave-audit

# --- JWT (RS256) ---
# Auth Service firma con una llave privada; el gateway y los servicios validan con la
# pública que Auth publica en /.well-known/jwks.json. No hay secreto compartido.
JWT_EMISOR=swmatrc-auth
JWT_AUDIENCIA=swmatrc-web
JWT_MINUTOS_VIGENCIA=480
# La llave privada se genera con:  ./infrastructure/docker/generar-llaves.sh  (queda en secrets/, no se versiona)

# --- OAuth 2.0 / OpenID Connect (Fase 4) ---
# Dirección pública por la que entra el navegador. Las URL de callback que se registran en
# los proveedores son  {URL_PUBLICA}/api/auth/callback/google  y  .../github.
#   Compose local:  http://localhost:10001     K3s en WSL:  http://localhost
#   Producción:     https://sistema-climatico.example
URL_PUBLICA=http://localhost:10001
# Quien entra por primera vez con Google/GitHub obtiene una cuenta VIEWER. false = solo
# pueden entrar correos que ya existan en el sistema.
OAUTH_REGISTRO_ABIERTO=true
# Un proveedor sin Client ID / Secret simplemente no aparece en la pantalla de acceso.
# Google: https://console.cloud.google.com  →  Google Auth Platform → Clients
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# GitHub: Settings → Developer settings → OAuth Apps
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# --- Sensores físicos (IoT) ---
# La Raspberry Pi manda sus lecturas con la cabecera X-Api-Key. Generar con: openssl rand -hex 32
IOT_RASPBERRY_LLAVE=cambie-esta-llave-del-dispositivo-iot
# Códigos de los sensores que reporta (deben existir en Sensor Service).
IOT_RASPBERRY_SENSORES=RPI-TEMP-01,RPI-HUM-01,RPI-VIB-01

# --- Credenciales de servicio a servicio ---
# Cada microservicio las cambia en Auth por un token interno de corta duración.
SVC_SECRETO_COMMUNITY=cambie-este-secreto-community
SVC_SECRETO_SENSOR=cambie-este-secreto-sensor
SVC_SECRETO_ALERT=cambie-este-secreto-alert
SVC_SECRETO_REPORT=cambie-este-secreto-report
SVC_SECRETO_AUDIT=cambie-este-secreto-audit

# --- Administrador inicial ---
# Solo se crea si auth_db no tiene ningún usuario (instalación nueva, sin migración).
ADMIN_EMAIL=admin@swmatrc.local
ADMIN_PASSWORD=cambie-esta-clave-admin

# Periodo del ciclo de adquisición de lecturas simuladas, en segundos.
SIMULACION_INTERVALO_SEGUNDOS=2

# --- Publicación ---
# El nginx de la VPS (o de WSL) reenvía /api y /hubs al gateway y el resto a la web.
PUERTO_GATEWAY=10000
PUERTO_WEB=10001
# Interfaz donde se publica. 127.0.0.1 = solo el proxy inverso local puede llegar.
# Use 0.0.0.0 únicamente si necesita entrar sin proxy (por ejemplo, desde otra máquina de la LAN).
IP_PUBLICACION=127.0.0.1
CORS_ORIGEN=http://localhost:10001
