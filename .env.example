# ---------------------------------------------------------------------------
# Configuración de despliegue. Copiar a .env y sustituir los valores.
#   cp .env.example .env
# El archivo .env no se versiona: contiene credenciales.
# ---------------------------------------------------------------------------

# --- SQL Server 2022 ---
# Requisitos del motor: mínimo 8 caracteres, con mayúsculas, minúsculas y dígitos o símbolos.
MSSQL_SA_PASSWORD=Swmatrc.Local.2026
MSSQL_DATABASE=SwmatrcDb

# --- API ---
# Clave de firma de los tokens JWT. Mínimo 32 caracteres.
# Generar una nueva para cada despliegue:  openssl rand -base64 48
JWT_CLAVE=cambie-esta-clave-por-una-aleatoria-de-al-menos-32-caracteres
JWT_MINUTOS_VIGENCIA=480

# Periodo del ciclo de adquisición de lecturas simuladas, en segundos.
SIMULACION_INTERVALO_SEGUNDOS=3

# --- Web ---
# Puerto publicado en el host. En la VPS, detrás de un proxy inverso con TLS.
PUERTO_WEB=8080
CORS_ORIGEN=http://localhost:8080
