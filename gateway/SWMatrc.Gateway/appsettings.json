{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Autenticacion": {
    "UrlMetadatos": "http://auth-service:3000/.well-known/openid-configuration",
    "Emisor": "swmatrc-auth",
    "Audiencia": "swmatrc-web",
    "RequiereHttps": false
  },

  "LimitePeticiones": {
    "GeneralPorMinuto": 600,
    "LoginPorMinuto": 10
  },

  "Cors": {
    "Origenes": [ "http://localhost:4200" ]
  },

  "ReverseProxy": {
    "Routes": {
      "auth-login": {
        "ClusterId": "auth",
        "Order": -1,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "limite-login",
        "CorsPolicy": "frontend",
        "Match": { "Path": "/api/auth/login", "Methods": [ "POST" ] }
      },
      "auth": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "limite-general",
        "CorsPolicy": "frontend",
        "Match": { "Path": "/api/auth/{**resto}" }
      },
      "communities": {
        "ClusterId": "community",
        "AuthorizationPolicy": "autenticado",
        "RateLimiterPolicy": "limite-general",
        "CorsPolicy": "frontend",
        "Match": { "Path": "/api/communities/{**resto}" }
      },
      "sensors": {
        "ClusterId": "sensor",
        "AuthorizationPolicy": "autenticado",
        "RateLimiterPolicy": "limite-general",
        "CorsPolicy": "frontend",
        "Match": { "Path": "/api/sensors/{**resto}" }
      },
      "hubs": {
        "ClusterId": "sensor",
        "AuthorizationPolicy": "autenticado",
        "CorsPolicy": "frontend",
        "Match": { "Path": "/hubs/{**resto}" }
      },
      "alerts": {
        "ClusterId": "alert",
        "AuthorizationPolicy": "autenticado",
        "RateLimiterPolicy": "limite-general",
        "CorsPolicy": "frontend",
        "Match": { "Path": "/api/alerts/{**resto}" }
      },
      "reports": {
        "ClusterId": "report",
        "AuthorizationPolicy": "autenticado",
        "RateLimiterPolicy": "limite-general",
        "CorsPolicy": "frontend",
        "Match": { "Path": "/api/reports/{**resto}" }
      },
      "audit": {
        "ClusterId": "audit",
        "AuthorizationPolicy": "autenticado",
        "RateLimiterPolicy": "limite-general",
        "CorsPolicy": "frontend",
        "Match": { "Path": "/api/audit/{**resto}" }
      }
    },

    "Clusters": {
      "auth": {
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:15", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health/ready" } },
        "Destinations": { "principal": { "Address": "http://auth-service:3000" } }
      },
      "community": {
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:15", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health/ready" } },
        "Destinations": { "principal": { "Address": "http://community-service:8080" } }
      },
      "sensor": {
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:15", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health/ready" } },
        "Destinations": { "principal": { "Address": "http://sensor-service:8080" } }
      },
      "alert": {
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:15", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health/ready" } },
        "Destinations": { "principal": { "Address": "http://alert-service:8080" } }
      },
      "report": {
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:15", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health/ready" } },
        "HttpRequest": { "ActivityTimeout": "00:03:00" },
        "Destinations": { "principal": { "Address": "http://report-service:8000" } }
      },
      "audit": {
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:15", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health/ready" } },
        "Destinations": { "principal": { "Address": "http://audit-service:8000" } }
      }
    }
  }
}
