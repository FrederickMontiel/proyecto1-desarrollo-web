# --------------------------------------------------------------------------------------
# Sitio de nginx para SWMATRC en un servidor que YA tiene nginx con otros sitios.
# Solo AGREGA este archivo: no modifica los sitios existentes.
#
# Traefik de K3s se instaló en puertos alternos (TRAEFIK_PUERTO_HTTP=8081 en instalar-k3s.sh).
#
#   sudo cp infrastructure/nginx/nginx-k3s.conf.example /etc/nginx/sites-available/swmatrc
#   sudo sed -i 's/sistema-climatico.example/SU-DOMINIO/g' /etc/nginx/sites-available/swmatrc
#   sudo ln -s /etc/nginx/sites-available/swmatrc /etc/nginx/sites-enabled/swmatrc
#   sudo nginx -t && sudo systemctl reload nginx        # reload, nunca restart
#   sudo certbot --nginx -d SU-DOMINIO                  # agrega el 443 y la redirección
# --------------------------------------------------------------------------------------

map $http_upgrade $swmatrc_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name sistema-climatico.example;

    client_max_body_size 4m;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SignalR (alertas en tiempo real) viaja por WebSocket en /hubs.
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $swmatrc_connection_upgrade;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }
}
