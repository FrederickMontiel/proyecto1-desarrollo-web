# Copiar a /home/admin/swmatrc/sensores.env (permisos 600) y completar.
# Producción: la dirección pública del sistema.  Local (K3s en WSL con túnel SSH): http://localhost:18080
SWMATRC_URL=https://sistema-climatico.example
# Igual a IOT_RASPBERRY_LLAVE del servidor (.env → Secret swmatrc-iot).
SWMATRC_LLAVE=
SENSOR_TEMPERATURA=RPI-TEMP-01
SENSOR_HUMEDAD=RPI-HUM-01
SENSOR_VIBRACION=RPI-VIB-01
INTERVALO_S=2
