{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Error"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "SqlServer": ""
  },

  "Autenticacion": {
    "UrlMetadatos": "http://auth-service:3000/.well-known/openid-configuration",
    "Emisor": "swmatrc-auth",
    "Audiencia": "swmatrc-web",
    "AudienciaInterna": "swmatrc-internal"
  },

  "Servicio": {
    "Nombre": "sensor-service",
    "Secreto": "",
    "UrlAuth": "http://auth-service:3000",
    "UrlAuditoria": "http://audit-service:8000"
  },

  "Servicios": {
    "UrlCommunity": "http://community-service:8080",
    "UrlAlert": "http://alert-service:8080"
  },

  "Simulacion": {
    "IntervaloSegundos": 3,
    "Habilitada": true,
    "CiclosToleranciaSinSenal": 3
  }
}
